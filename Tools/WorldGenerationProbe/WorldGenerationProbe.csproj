<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <WorldSourceRoot Condition="'$(WorldSourceRoot)' == ''">../../Archives/Alpha-v0.0.10-Source</WorldSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WorldSourceRoot)/Assets/Scripts/Core/*.cs" />
    <Compile Include="$(WorldSourceRoot)/Assets/Scripts/World/*.cs" />
    <Compile Include="$(WorldSourceRoot)/Assets/Scripts/Simulation/*.cs" />
    <Compile Include="$(WorldSourceRoot)/Assets/Scripts/Persistence/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
